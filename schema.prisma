generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model regiones {
  id_region     Int           @id @default(autoincrement())
  codigo_region String        @unique @db.VarChar(10)
  nombre        String        @db.VarChar(100)
  created_at    DateTime      @default(now())
  updated_at    DateTime?     @updatedAt
  comunas       comunas[]
  direcciones   direcciones[]

  @@map("regiones")
}

model comunas {
  id_comuna   Int           @id @default(autoincrement())
  id_region   Int
  nombre      String        @db.VarChar(100)
  created_at  DateTime      @default(now())
  updated_at  DateTime?     @updatedAt
  region      regiones      @relation(fields: [id_region], references: [id_region])
  direcciones direcciones[]

  @@map("comunas")
}

model direcciones {
  id_direccion          Int           @id @default(autoincrement())
  calle                 String        @db.VarChar(200)
  numero                String?       @db.VarChar(20)
  departamento          String?       @db.VarChar(20)
  id_comuna             Int
  id_region             Int
  codigo_postal         String?       @db.VarChar(10)
  referencia            String?
  latitud               Decimal?      @db.Decimal(9, 6)
  longitud              Decimal?      @db.Decimal(9, 6)
  direccion_completa    String?
  activa                Boolean       @default(true)
  created_at            DateTime      @default(now())
  updated_at            DateTime?     @updatedAt
  clientes_direccion    clientes[]
  comuna                comunas       @relation(fields: [id_comuna], references: [id_comuna])
  region                regiones      @relation(fields: [id_region], references: [id_region])
  pedidos_direccion     pedidos[]
  proveedores_direccion proveedores[]

  @@map("direcciones")
}

model usuarios {
  id_usuario          Int                     @id @default(autoincrement())
  nombre              String                  @db.VarChar(100)
  email               String                  @unique @db.VarChar(100)
  contrasena_hash     String
  fecha_registro      DateTime                @default(now()) @db.Timestamp(6)
  activo              Boolean                 @default(true)
  profile_picture_url String?
  id_plan             Int?
  created_at          DateTime                @default(now())
  updated_at          DateTime?               @updatedAt
  auth_uid            String?                 @unique(map: "idx_usuarios_auth_uid") @db.Uuid
  carrito             carrito[]
  cliente             clientes?
  comentarios         comentarios[]
  lista_deseos        lista_deseos[]
  notificaciones      notificaciones[]
  pagos               pagos[]
  participaciones     ParticipanteColectivo[]
  pedidos             pedidos[]
  proveedor           proveedores?
  solicitudescontacto solicitudescontacto[]
  roles               UsuarioRol[]
  plan                planes?                 @relation(fields: [id_plan], references: [id_plan])
  
  // Stock management relations
  movimientos_stock_registro movimientos_stock[] @relation("UsuarioMovimientoStock")
  alertas_resueltas         alertas_stock[]     @relation("UsuarioAlertaResuelta")
  reservas_stock            reservas_stock[]
  
  // Analytics relation
  eventos_analytics         eventos_analytics[]

  @@map("usuarios")
}

model roles {
  id_rol      Int          @id @default(autoincrement())
  nombre      String       @unique @db.VarChar(50)
  descripcion String?
  usuarios    UsuarioRol[]

  @@map("roles")
}

model UsuarioRol {
  id_usuario Int
  id_rol     Int
  rol        roles    @relation(fields: [id_rol], references: [id_rol])
  usuario    usuarios @relation(fields: [id_usuario], references: [id_usuario])

  @@id([id_usuario, id_rol])
  @@map("usuario_rol")
}

model proveedores {
  id_proveedor        Int                   @id @default(autoincrement())
  id_usuario          Int                   @unique
  nombre_negocio      String                @db.VarChar(100)
  descripcion         String?
  telefono_contacto   String?               @db.VarChar(20)
  id_direccion        Int?
  latitud             Decimal?              @db.Decimal(9, 6)
  longitud            Decimal?              @db.Decimal(9, 6)
  destacado           Boolean               @default(false)
  email               String?               @unique @db.VarChar(100)
  radio_entrega_km    Int?                  @default(10)
  cobra_envio         Boolean               @default(true)
  envio_gratis_desde  Decimal?              @db.Decimal(10, 2)
  created_at          DateTime              @default(now())
  updated_at          DateTime?             @updatedAt
  areas_servicio      areas_servicio[]
  campanas_colectivas compras_colectivas[]
  productos           productos[]
  direccion           direcciones?          @relation(fields: [id_direccion], references: [id_direccion])
  usuario             usuarios              @relation(fields: [id_usuario], references: [id_usuario])
  publicidad          publicidad[]
  solicitudescontacto solicitudescontacto[]
  suscripciones       suscripciones[]
  
  // Stock management relations
  whatsapp_config     whatsapp_config?
  
  // Analytics relation
  eventos_analytics   eventos_analytics[]

  @@map("proveedores")
}

model areas_servicio {
  id_area             Int         @id @default(autoincrement())
  id_proveedor        Int
  tipo                String      @db.VarChar(20)
  id_comuna           Int?
  id_region           Int?
  radio_km            Int?
  costo_envio         Decimal?    @db.Decimal(8, 2)
  tiempo_entrega_dias Int?        @default(3)
  activa              Boolean     @default(true)
  created_at          DateTime    @default(now())
  updated_at          DateTime?   @updatedAt
  proveedor           proveedores @relation(fields: [id_proveedor], references: [id_proveedor])

  @@map("areas_servicio")
}

model clientes {
  id_cliente     Int          @id @default(autoincrement())
  id_usuario     Int          @unique
  id_direccion   Int?
  telefono       String?      @db.VarChar(20)
  fecha_registro DateTime     @default(now()) @db.Timestamp(6)
  created_at     DateTime     @default(now())
  updated_at     DateTime?    @updatedAt
  direccion      direcciones? @relation(fields: [id_direccion], references: [id_direccion])
  usuario        usuarios     @relation(fields: [id_usuario], references: [id_usuario])

  @@map("clientes")
}

model categorias {
  id_categoria Int         @id @default(autoincrement())
  nombre       String      @db.VarChar(100)
  created_at   DateTime    @default(now())
  updated_at   DateTime?   @updatedAt
  productos    productos[]

  @@map("categorias")
}

model productos {
  id_producto               Int                   @id @default(autoincrement())
  id_proveedor              Int
  id_categoria              Int
  nombre_producto           String                @db.VarChar(100)
  descripcion               String?
  precio_unitario           Decimal               @db.Decimal(10, 2)
  imagen_url                String?
  disponible                Boolean               @default(true)
  elegible_compra_colectiva Boolean               @default(true)
  fecha_publicacion         DateTime              @default(now()) @db.Timestamp(6)
  created_at                DateTime              @default(now())
  updated_at                DateTime?             @default(now()) @updatedAt
  unit_type                 String?               @default("unit") @db.VarChar(10)
  
  // Stock management fields
  stock_actual              Int                   @default(0)
  stock_minimo              Int                   @default(0)
  stock_maximo              Int?                  @default(999999)
  alerta_stock_bajo         Boolean               @default(true)
  permite_venta_sin_stock   Boolean               @default(false)
  dias_reabastecimiento     Int?                  @default(7)
  ultimo_reabastecimiento   DateTime?
  
  // Existing relations
  carrito                   carrito[]
  comentarios               comentarios[]
  campanas_colectivas       compras_colectivas[]
  descuentos_cantidad       descuentos_cantidad[]
  items_pedido              ItemPedido[]
  lista_deseos              lista_deseos[]
  categoria                 categorias            @relation(fields: [id_categoria], references: [id_categoria])
  proveedor                 proveedores           @relation(fields: [id_proveedor], references: [id_proveedor])
  
  // Stock management relations
  movimientos_stock         movimientos_stock[]
  alertas_stock             alertas_stock[]
  reservas_stock            reservas_stock[]
  whatsapp_mensajes         whatsapp_mensajes[]
  eventos_analytics         eventos_analytics[]

  @@index([id_proveedor, disponible])
  @@index([stock_actual])
  @@map("productos")
}

model descuentos_cantidad {
  id_descuento         Int       @id @default(autoincrement())
  id_producto          Int
  cantidad_minima      Int
  descuento_porcentaje Decimal   @db.Decimal(5, 2)
  precio_descuento     Decimal?  @db.Decimal(10, 2)
  activo               Boolean   @default(true)
  created_at           DateTime  @default(now())
  updated_at           DateTime? @default(now()) @updatedAt
  producto             productos @relation(fields: [id_producto], references: [id_producto])

  @@unique([id_producto, cantidad_minima])
  @@map("descuentos_cantidad")
}

model comentarios {
  id_comentario Int       @id @default(autoincrement())
  id_cliente    Int
  id_producto   Int
  texto         String
  calificacion  Int
  fecha         DateTime  @default(now()) @db.Timestamp(6)
  created_at    DateTime  @default(now())
  updated_at    DateTime? @updatedAt
  cliente       usuarios  @relation(fields: [id_cliente], references: [id_usuario])
  producto      productos @relation(fields: [id_producto], references: [id_producto])

  @@map("comentarios")
}

model solicitudescontacto {
  id_solicitud    Int         @id @default(autoincrement())
  id_cliente      Int
  id_proveedor    Int
  mensaje         String
  fecha_solicitud DateTime    @default(now()) @db.Timestamp(6)
  estado          String      @default("pendiente")
  created_at      DateTime    @default(now())
  updated_at      DateTime?   @updatedAt
  cliente         usuarios    @relation(fields: [id_cliente], references: [id_usuario])
  proveedor       proveedores @relation(fields: [id_proveedor], references: [id_proveedor])

  @@map("solicitudescontacto")
}

model planes {
  id_plan        Int             @id @default(autoincrement())
  nombre         String          @db.VarChar(50)
  precio_mensual Decimal         @db.Decimal(10, 2)
  descripcion    String?
  created_at     DateTime        @default(now())
  updated_at     DateTime?       @updatedAt
  suscripciones  suscripciones[]
  usuarios       usuarios[]

  @@map("planes")
}

model suscripciones {
  id_suscripcion Int         @id @default(autoincrement())
  id_proveedor   Int
  id_plan        Int
  fecha_inicio   DateTime    @db.Timestamp(6)
  fecha_fin      DateTime?   @db.Timestamp(6)
  activa         Boolean     @default(true)
  created_at     DateTime    @default(now())
  updated_at     DateTime?   @updatedAt
  plan           planes      @relation(fields: [id_plan], references: [id_plan])
  proveedor      proveedores @relation(fields: [id_proveedor], references: [id_proveedor])

  @@map("suscripciones")
}

model pagos {
  id_pago     Int      @id @default(autoincrement())
  id_usuario  Int
  monto       Decimal  @db.Decimal(10, 2)
  metodo_pago String   @db.VarChar(50)
  fecha_pago  DateTime @default(now()) @db.Timestamp(6)
  estado      String   @default("pendiente")
  id_pedido   Int?
  created_at  DateTime @default(now())
  updated_at  DateTime? @updatedAt
  pedido      pedidos? @relation(fields: [id_pedido], references: [id_pedido])
  usuario     usuarios @relation(fields: [id_usuario], references: [id_usuario])

  @@map("pagos")
}

model publicidad {
  id_publicidad    Int         @id @default(autoincrement())
  id_proveedor     Int
  imagen_destacada String?
  texto_destacado  String?
  fecha_inicio     DateTime    @db.Timestamp(6)
  fecha_fin        DateTime?   @db.Timestamp(6)
  activa           Boolean     @default(true)
  created_at       DateTime    @default(now())
  updated_at       DateTime?   @updatedAt
  proveedor        proveedores @relation(fields: [id_proveedor], references: [id_proveedor])

  @@map("publicidad")
}

model compras_colectivas {
  id_campana              Int                     @id @default(autoincrement())
  nombre                  String                  @db.VarChar(100)
  descripcion             String?
  id_proveedor            Int
  id_producto             Int
  precio_objetivo         Decimal                 @db.Decimal(10, 2)
  cantidad_objetivo       Int
  min_participantes       Int?
  max_participantes       Int?
  cantidad_min_usuario    Int                     @default(1)
  cantidad_max_usuario    Int?
  requiere_aprobacion     Boolean                 @default(false)
  id_descuento_aplicado   Int?
  fecha_inicio            DateTime                @default(now())
  fecha_fin               DateTime?
  estado                  String                  @default("abierta")
  created_at              DateTime                @default(now())
  updated_at              DateTime?               @updatedAt
  producto                productos               @relation(fields: [id_producto], references: [id_producto])
  proveedor               proveedores             @relation(fields: [id_proveedor], references: [id_proveedor])
  escalas_precios         escalas_precios[]
  notificaciones          notificaciones[]
  participantes           ParticipanteColectivo[]
  pedidos                 pedidos[]
  progreso                progreso_campana?
  
  // Stock management relations
  movimientos_stock       movimientos_stock[]
  reservas_stock          reservas_stock[]
  eventos_analytics       eventos_analytics[]

  @@map("compras_colectivas")
}

model ParticipanteColectivo {
  id_participante Int                @id @default(autoincrement())
  id_campana      Int
  id_usuario      Int
  cantidad        Int
  monto_aportado  Decimal            @db.Decimal(10, 2)
  fecha_aporte    DateTime           @default(now())
  estado          String             @default("activo")
  created_at      DateTime           @default(now())
  updated_at      DateTime?          @updatedAt
  campana         compras_colectivas @relation(fields: [id_campana], references: [id_campana])
  usuario         usuarios           @relation(fields: [id_usuario], references: [id_usuario])

  @@unique([id_campana, id_usuario])
  @@map("participantes_colectivos")
}

model escalas_precios {
  id_escala            Int                @id @default(autoincrement())
  id_campana           Int
  cantidad_minima      Int
  precio_unitario      Decimal            @db.Decimal(10, 2)
  descuento_porcentaje Decimal?           @db.Decimal(5, 2)
  activa               Boolean            @default(true)
  created_at           DateTime           @default(now())
  updated_at           DateTime?          @updatedAt
  campana              compras_colectivas @relation(fields: [id_campana], references: [id_campana])

  @@map("escalas_precios")
}

model progreso_campana {
  id_progreso            Int                @id @default(autoincrement())
  id_campana             Int                @unique
  participantes_actuales Int                @default(0)
  cantidad_actual        Int                @default(0)
  monto_recaudado        Decimal            @default(0) @db.Decimal(15, 2)
  porcentaje_completado  Decimal            @default(0) @db.Decimal(5, 2)
  precio_actual          Decimal?           @db.Decimal(10, 2)
  siguiente_tier         Int?
  created_at             DateTime           @default(now())
  updated_at             DateTime?          @updatedAt
  campana                compras_colectivas @relation(fields: [id_campana], references: [id_campana])

  @@map("progreso_campanas")
}

model pedidos {
  id_pedido            Int                 @id @default(autoincrement())
  id_usuario           Int
  tipo_pedido          String
  id_campana           Int?
  total                Decimal             @db.Decimal(10, 2)
  estado               String              @default("pendiente")
  fecha_pedido         DateTime            @default(now())
  fecha_entrega        DateTime?
  id_direccion_entrega Int?
  costo_envio          Decimal?            @db.Decimal(8, 2)
  notas                String?
  created_at           DateTime            @default(now())
  updated_at           DateTime?           @updatedAt
  items                ItemPedido[]
  pagos                pagos[]
  campana              compras_colectivas? @relation(fields: [id_campana], references: [id_campana])
  direccion_entrega    direcciones?        @relation(fields: [id_direccion_entrega], references: [id_direccion])
  usuario              usuarios            @relation(fields: [id_usuario], references: [id_usuario])
  
  // Stock management relations
  movimientos_stock    movimientos_stock[]
  reservas_stock       reservas_stock[]

  @@map("pedidos")
}

model ItemPedido {
  id_item         Int       @id @default(autoincrement())
  id_pedido       Int
  id_producto     Int
  cantidad        Int
  precio_unitario Decimal   @db.Decimal(10, 2)
  subtotal        Decimal   @db.Decimal(10, 2)
  created_at      DateTime  @default(now())
  updated_at      DateTime? @updatedAt
  pedido          pedidos   @relation(fields: [id_pedido], references: [id_pedido])
  producto        productos @relation(fields: [id_producto], references: [id_producto])

  @@map("items_pedido")
}

model notificaciones {
  id_notificacion Int                 @id @default(autoincrement())
  id_usuario      Int
  tipo            String
  titulo          String              @db.VarChar(200)
  mensaje         String
  leida           Boolean             @default(false)
  id_campana      Int?
  url_accion      String?             @db.VarChar(255)
  created_at      DateTime            @default(now())
  updated_at      DateTime?           @updatedAt
  campana         compras_colectivas? @relation(fields: [id_campana], references: [id_campana])
  usuario         usuarios            @relation(fields: [id_usuario], references: [id_usuario])

  @@map("notificaciones")
}

model lista_deseos {
  id_lista          Int       @id @default(autoincrement())
  id_usuario        Int
  id_producto       Int
  notificar_campana Boolean   @default(true)
  cantidad_deseada  Int?
  precio_maximo     Decimal?  @db.Decimal(10, 2)
  created_at        DateTime  @default(now())
  updated_at        DateTime? @updatedAt
  producto          productos @relation(fields: [id_producto], references: [id_producto])
  usuario           usuarios  @relation(fields: [id_usuario], references: [id_usuario])

  @@unique([id_usuario, id_producto])
  @@map("lista_deseos")
}

model carrito {
  id_carrito      Int       @id @default(autoincrement())
  id_usuario      Int
  id_producto     Int
  cantidad        Int
  precio_unitario Decimal   @db.Decimal(10, 2)
  created_at      DateTime  @default(now())
  updated_at      DateTime? @updatedAt
  producto        productos @relation(fields: [id_producto], references: [id_producto])
  usuario         usuarios  @relation(fields: [id_usuario], references: [id_usuario])

  @@unique([id_usuario, id_producto])
  @@map("carrito")
}

// ============================================
// STOCK MANAGEMENT ENUMS
// ============================================

enum TipoMovimiento {
  ENTRADA_COMPRA          // Stock added from purchase
  ENTRADA_DEVOLUCION      // Stock returned by customer
  ENTRADA_AJUSTE          // Manual adjustment (increase)
  SALIDA_VENTA            // Stock sold
  SALIDA_DEVOLUCION       // Stock returned to supplier
  SALIDA_MERMA            // Stock loss/waste
  SALIDA_AJUSTE           // Manual adjustment (decrease)
  RESERVA                 // Stock reserved for pending order
  LIBERACION_RESERVA      // Reserved stock released
  ENTRADA_REABASTECIMIENTO // Stock replenishment
}

enum MetodoRegistro {
  MANUAL                  // Registered manually by user
  AUTOMATICO              // Auto-registered by system
  WHATSAPP                // Registered via WhatsApp bot
  API                     // Registered via API call
  IMPORTACION             // Imported from file/batch
}

enum TipoAlerta {
  STOCK_BAJO              // Stock below minimum
  STOCK_CRITICO           // Stock at critical level
  STOCK_AGOTADO           // Stock depleted
  REABASTECIMIENTO_PENDIENTE // Restock needed
  RESERVA_EXPIRADA        // Reserved stock expired
}

enum TipoReserva {
  PEDIDO                  // Reserved for order
  CAMPANA                 // Reserved for campaign
  APARTADO                // Reserved/held by customer
}

enum EstadoReserva {
  ACTIVA                  // Currently reserved
  COMPLETADA              // Reservation fulfilled
  CANCELADA               // Reservation cancelled
  EXPIRADA                // Reservation expired
}

enum AccionWhatsApp {
  CONSULTA_STOCK          // Check stock level
  ENTRADA_STOCK           // Add stock
  SALIDA_STOCK            // Remove stock
  AJUSTE_STOCK            // Adjust stock
  ALERTA_CONFIG           // Configure alerts
  REPORTE                 // Generate report
  AYUDA                   // Help command
}

// ============================================
// STOCK MANAGEMENT MODELS
// ============================================

model movimientos_stock {
  id_movimiento        Int              @id @default(autoincrement())
  id_producto          Int
  tipo_movimiento      TipoMovimiento
  cantidad             Int
  stock_previo         Int
  stock_resultante     Int
  metodo_registro      MetodoRegistro   @default(AUTOMATICO)
  id_usuario_registro  Int?
  id_pedido            Int?
  id_campana           Int?
  id_reserva           Int?
  observaciones        String?
  costo_unitario       Decimal?         @db.Decimal(10, 2)
  costo_total          Decimal?         @db.Decimal(10, 2)
  numero_factura       String?          @db.VarChar(100)
  fecha_movimiento     DateTime         @default(now())
  created_at           DateTime         @default(now())
  
  // Relations
  producto             productos        @relation(fields: [id_producto], references: [id_producto])
  usuario              usuarios?        @relation("UsuarioMovimientoStock", fields: [id_usuario_registro], references: [id_usuario])
  pedido               pedidos?         @relation(fields: [id_pedido], references: [id_pedido])
  campana              compras_colectivas? @relation(fields: [id_campana], references: [id_campana])
  reserva              reservas_stock?  @relation(fields: [id_reserva], references: [id_reserva])

  @@index([id_producto, fecha_movimiento])
  @@index([tipo_movimiento])
  @@index([metodo_registro])
  @@map("movimientos_stock")
}

model alertas_stock {
  id_alerta            Int              @id @default(autoincrement())
  id_producto          Int
  tipo_alerta          TipoAlerta
  stock_actual         Int
  stock_minimo         Int?
  mensaje              String
  resuelta             Boolean          @default(false)
  fecha_resolucion     DateTime?
  id_usuario_resolvio  Int?
  notas_resolucion     String?
  fecha_alerta         DateTime         @default(now())
  created_at           DateTime         @default(now())
  
  // Relations
  producto             productos        @relation(fields: [id_producto], references: [id_producto])
  usuario_resolvio     usuarios?        @relation("UsuarioAlertaResuelta", fields: [id_usuario_resolvio], references: [id_usuario])

  @@index([id_producto, resuelta])
  @@index([tipo_alerta, resuelta])
  @@map("alertas_stock")
}

model whatsapp_config {
  id_config            Int              @id @default(autoincrement())
  id_proveedor         Int              @unique
  numero_whatsapp      String           @db.VarChar(20)
  webhook_token        String           @unique
  activo               Boolean          @default(true)
  notificar_stock_bajo Boolean          @default(true)
  notificar_ventas     Boolean          @default(true)
  idioma               String           @default("es") @db.VarChar(5)
  created_at           DateTime         @default(now())
  updated_at           DateTime?        @updatedAt
  
  // Relations
  proveedor            proveedores      @relation(fields: [id_proveedor], references: [id_proveedor])
  mensajes             whatsapp_mensajes[]

  @@map("whatsapp_config")
}

model whatsapp_mensajes {
  id_mensaje           Int              @id @default(autoincrement())
  id_config            Int
  numero_remitente     String           @db.VarChar(20)
  mensaje_entrante     String
  mensaje_respuesta    String?
  accion               AccionWhatsApp?
  id_producto          Int?
  datos_procesados     Json?
  procesado_exitoso    Boolean          @default(false)
  error                String?
  fecha_mensaje        DateTime         @default(now())
  created_at           DateTime         @default(now())
  
  // Relations
  config               whatsapp_config  @relation(fields: [id_config], references: [id_config])
  producto             productos?       @relation(fields: [id_producto], references: [id_producto])

  @@index([id_config, fecha_mensaje])
  @@index([accion])
  @@map("whatsapp_mensajes")
}

model reservas_stock {
  id_reserva           Int              @id @default(autoincrement())
  id_producto          Int
  tipo_reserva         TipoReserva
  cantidad_reservada   Int
  estado               EstadoReserva    @default(ACTIVA)
  id_usuario           Int?
  id_pedido            Int?
  id_campana           Int?
  fecha_reserva        DateTime         @default(now())
  fecha_expiracion     DateTime?
  fecha_liberacion     DateTime?
  observaciones        String?
  created_at           DateTime         @default(now())
  updated_at           DateTime?        @updatedAt
  
  // Relations
  producto             productos        @relation(fields: [id_producto], references: [id_producto])
  usuario              usuarios?        @relation(fields: [id_usuario], references: [id_usuario])
  pedido               pedidos?         @relation(fields: [id_pedido], references: [id_pedido])
  campana              compras_colectivas? @relation(fields: [id_campana], references: [id_campana])
  movimientos          movimientos_stock[]

  @@index([id_producto, estado])
  @@index([estado, fecha_expiracion])
  @@map("reservas_stock")
}

// ============================================
// ANALYTICS & TRACKING
// ============================================

enum TipoEventoAnalytics {
  product_view
  add_to_cart
  remove_from_cart
  supplier_profile_view
  campaign_view
  campaign_join
  begin_checkout
  purchase
  search
  
  @@map("tipo_evento_analytics")
}

model eventos_analytics {
  id_evento     BigInt                @id @default(autoincrement())
  id_usuario    Int?
  id_proveedor  Int?
  id_producto   Int?
  id_campana    Int?
  tipo_evento   TipoEventoAnalytics
  metadata      Json?                 // Additional event-specific data (e.g., quantity, price, search term)
  session_id    String?               @db.VarChar(100)
  user_agent    String?               @db.VarChar(500)
  ip_address    String?               @db.VarChar(45)  // Support IPv6
  referrer      String?               @db.VarChar(500)
  page_url      String?               @db.VarChar(1000)
  created_at    DateTime              @default(now())
  
  // Relations
  usuario       usuarios?             @relation(fields: [id_usuario], references: [id_usuario], onDelete: SetNull)
  proveedor     proveedores?          @relation(fields: [id_proveedor], references: [id_proveedor], onDelete: SetNull)
  producto      productos?            @relation(fields: [id_producto], references: [id_producto], onDelete: SetNull)
  campana       compras_colectivas?   @relation(fields: [id_campana], references: [id_campana], onDelete: SetNull)
  
  // Indexes for efficient querying
  @@index([id_proveedor, created_at])
  @@index([id_producto, tipo_evento, created_at])
  @@index([id_usuario, created_at])
  @@index([tipo_evento, created_at])
  @@index([session_id])
  @@map("eventos_analytics")
}
